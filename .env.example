# ==============================================================
# C Compiler Web Application - Environment Variables
# ==============================================================

# Backend Configuration
PORT=5005
HOST=0.0.0.0
NODE_ENV=development

# Path to the compiled C compiler binary (default is auto-resolved)
COMPILER_BIN=./ccompiler

# CORS Allowed Origin for production deployment (comma-separated or * for dev)
CORS_ORIGIN=*

# Frontend API Base URL (empty string uses relative /api or Vite proxy)
VITE_API_BASE_URL=
